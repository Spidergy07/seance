{
  "name": "seance",
  "version": "0.1.0",
  "description": "Restore dead websites from the Internet Archive Wayback Machine.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "fast-check": "3.23.2",
    "globals": "15.14.0",
    "linkedom": "0.18.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
